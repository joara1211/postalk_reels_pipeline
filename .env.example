PORT=8000
SUPABASE_URL=https://your-project.supabase.co
REELS_INTERNAL_API_KEY=
# AI-generated scene captions, Instagram caption and hashtags.
# Production uses OPENAI_API_KEY (Railway reference to the backend's variable).
# Without any key, the service falls back to default captions/hashtags.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional alternatives for local testing. When several keys are set, the
# order is OpenAI > Anthropic > Gemini; LLM_PROVIDER (openai | anthropic | gemini)
# forces a choice. LLM_MODEL overrides the Anthropic/Gemini default model.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
