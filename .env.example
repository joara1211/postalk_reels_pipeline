PORT=8000
SUPABASE_URL=https://your-project.supabase.co
REELS_INTERNAL_API_KEY=
# Optional when requesting scripts directly from this service.
# Set one of the two keys. With only GEMINI_API_KEY set, Gemini is used;
# LLM_PROVIDER (anthropic | gemini) forces a choice when both are set.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=
# Empty = provider default (claude-opus-5-5 / gemini-2.5-flash).
LLM_MODEL=
