{
  "concept": "simple",
  "name": "심플",
  "has_captions": true,
  "audio": {
    "_note": "bgm_tracks 중 한 곡을 렌더마다 무작위로 고른다(pipeline.pick_bgm_path). bgm은 기본곡(목록에도 포함). 출처·라이선스는 assets/bgm/CREDITS.md",
    "bgm": "assets/bgm/MP_맑은 아침 (Short).mp3",
    "bgm_tracks": [
      "assets/bgm/MP_맑은 아침 (Short).mp3",
      "assets/bgm/simple_go_to_the_picnic.mp3",
      "assets/bgm/simple_ice_cream_with_you.mp3",
      "assets/bgm/simple_sweet_sun.mp3"
    ],
    "bgm_volume": 0.3
  },
  "scene_rule": {
    "common": [
      {
        "scene_type": "hook",
        "position": "first",
        "source": "camera",
        "duration_sec": 3.0,
        "caption_max_chars": 20,
        "min_record_sec": 3,
        "guide": "휴대폰을 가로로 들고 대표 상품이 모두 보이게 찍어주세요",
        "guide_image": "hook"
      },
      {
        "scene_type": "outro",
        "position": "last",
        "source": "gallery",
        "duration_sec": 3.0,
        "caption_max_chars": 20,
        "min_record_sec": 2,
        "guide": "가게 모습이 담긴 가로 영상을 골라주세요",
        "guide_image": "outro"
      }
    ],
    "per_menu": [
      {
        "scene_type": "closeup",
        "source": "camera",
        "caption_max_chars": 18,
        "min_record_sec": 3,
        "guide": "가로로 들고 가까이서 천천히 찍어주세요",
        "guide_image": "closeup"
      },
      {
        "scene_type": "detail",
        "source": "camera",
        "caption_max_chars": 24,
        "min_record_sec": 3,
        "guide": "가로로 들고 단면이나 질감이 보이게 찍어주세요",
        "guide_image": "detail"
      }
    ],
    "menu_block_sec": { "1": 10.0, "2": 14.0, "3": 18.0 }
  },
  "render": {
    "landscape_fit": {
      "_note": "가로 영상만 해당. crop이면 세로로 꽉 채우게 가운데를 잘라냄(가로 영상은 너무 확대돼 보임). blur면 가로 영상 전체를 가운데에 두고 위아래를 같은 영상을 흐리게 깔아 채움. foreground_aspect(가로/세로, 예 1.0=정사각형)를 주면 그 비율까지만 양옆을 잘라 더 크게 보여줌. 2026-11-18 결정: 전체 화면(blur, foreground_aspect 없음)",
      "mode": "blur"
    },
    "_note": "디자인 미확정 임시값. 팀 디자인 확정되면 이 블록만 고치면 된다 (코드 변경 없음).",
    "canvas": { "width": 1080, "height": 1920, "fps": 30 },
    "fade_sec": 0.5,
    "ffmpeg_preset": "veryfast",
    "transition": { "type": "fade", "duration_sec": 0.3 },
    "subtitle": {
      "_note": "2026-11-07: christmas.json과 글자 크기/위치를 맞추고(font_size 64->76, margin_v 440->560), 박스 배경은 뺐다(border_style 3->1, 윤곽선만). back_color는 border_style=1에서는 안 쓰이지만 나중에 박스형으로 되돌릴 때 바로 쓸 수 있게 값은 남겨둠.",
      "font_name": "Griun Fromsol",
      "font_file": "assets/font/Griun_Fromsol-Rg.ttf",
      "font_size": 76,
      "primary_color": "&H00FFFFFF",
      "back_color": "&H80000000",
      "border_style": 1,
      "outline": 2,
      "margin_v": 560
    }
  }
}
